-- 3. EXECUÇÃO DOS MODOS (INCLUINDO FLING SIMPLE)
---------------------------------------------------------
local selectedModeData = nil
local selectedTargetPlayer = nil
local activeMode = false

local currentTrack = nil
local actionConnection = nil
local noclipConnection = nil
local orbitAngle = 0
local isLoopRunning = false

local function stopExecution()
	activeMode = false
	isLoopRunning = false
	activateBtn.Text = "Enable"

	if actionConnection then actionConnection:Disconnect() actionConnection = nil end
	if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end

	if currentTrack then
		currentTrack:Stop(0.1)
		currentTrack = nil
	end

	local char = LocalPlayer.Character
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.PlatformStand = false
		char.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

closeBtn.MouseButton1Click:Connect(function()
	stopExecution()
	screenGui:Destroy()
end)

local function forceCFrame(targetCFrame)
	local myChar = LocalPlayer.Character
	if not myChar then return end

	local myHRP = myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar:FindFirstChild("Humanoid")

	if myHRP then
		if myHum then 
			myHum.PlatformStand = true 
			if myHum:GetState() ~= Enum.HumanoidStateType.Physics then
				myHum:ChangeState(Enum.HumanoidStateType.Physics)
			end
		end

		myHRP.CFrame = targetCFrame
		myHRP.AssemblyLinearVelocity = Vector3.zero
		myHRP.AssemblyAngularVelocity = Vector3.zero
	end
end

local function startExecution()
	if not selectedModeData or not selectedTargetPlayer then return end

	activeMode = true
	isLoopRunning = true
	activateBtn.Text = "Disable"

	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("Humanoid") then return end
	local hum = char.Humanoid

	noclipConnection = RunService.Stepped:Connect(function()
		local myChar = LocalPlayer.Character
		if myChar then
			for _, part in ipairs(myChar:GetDescendants()) do
				if part:IsA("BasePart") then 
					part.CanCollide = false 
				end
			end
		end
	end)

	-- Carrega animação se o modo possuir ID
	if selectedModeData.Id then
		local animIdStr = "rbxassetid://" .. tostring(selectedModeData.Id)
		local success, asset = pcall(function() return game:GetObjects(animIdStr)[1] end)
		if success and asset and asset:IsA("Animation") then
			currentTrack = hum:LoadAnimation(asset)
		else
			local animObj = Instance.new("Animation")
			animObj.AnimationId = animIdStr
			currentTrack = hum:LoadAnimation(animObj)
		end

		if currentTrack then
			currentTrack.Priority = Enum.AnimationPriority.Action4
			if selectedModeData.Type == "BangBang" then
				currentTrack.Looped = true
			end
			currentTrack:Play(0.05)

			if selectedModeData.FreezeTime then
				task.delay(selectedModeData.FreezeTime, function()
					if currentTrack and currentTrack.IsPlaying then
						currentTrack:AdjustSpeed(0.00000001)
					end
				end)
			end
		end
	end

	-- Loop hyper-potente para os modos
	task.spawn(function()
		local toggleFrame = false
		while isLoopRunning and activeMode do
			task.wait()

			local targetChar = selectedTargetPlayer and selectedTargetPlayer.Character
			if targetChar then
				local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
				local targetTorso = targetChar:FindFirstChild("Torso") 
					or targetChar:FindFirstChild("UpperTorso") 
					or targetHRP

				if selectedModeData.Type == "Stand" and targetHRP then
					forceCFrame(targetHRP.CFrame * CFrame.new(2.2, 0.4, 1.5))

				elseif selectedModeData.Type == "Orbit" and targetTorso then
					orbitAngle = orbitAngle + 0.08
					local offsetX = math.cos(orbitAngle) * selectedModeData.Radius
					local offsetZ = math.sin(orbitAngle) * selectedModeData.Radius
					local targetPos = targetTorso.Position + Vector3.new(offsetX, 0, offsetZ)

					forceCFrame(CFrame.new(targetPos, targetTorso.Position))

				elseif selectedModeData.Type == "BangBang" and targetHRP then
					forceCFrame(targetHRP.CFrame * CFrame.new(0, 1.0, 2.2))

				-- NOVO: FLING SIMPLE (Alterna entre dentro do torso e órbita em 7 studs em velocidade absurda)
				elseif selectedModeData.Type == "FlingSimple" and targetHRP then
					toggleFrame = not toggleFrame
					if toggleFrame then
						-- Teleporta para dentro do torso/HRP gerando Fling
						forceCFrame(targetHRP.CFrame)
					else
						-- Teleporta rodando ao redor em 7 studs em todos os ângulos
						orbitAngle = orbitAngle + 0.4 -- Velocidade absurda de rotação
						local offsetX = math.cos(orbitAngle) * selectedModeData.Radius
						local offsetZ = math.sin(orbitAngle) * selectedModeData.Radius
						local targetPos = targetHRP.Position + Vector3.new(offsetX, math.sin(orbitAngle) * 2, offsetZ)
						forceCFrame(CFrame.new(targetPos, targetHRP.Position))
					end
				end
			end
		end
	end)

	actionConnection = RunService.RenderStepped:Connect(function()
		local targetChar = selectedTargetPlayer and selectedTargetPlayer.Character
		if targetChar then
			local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
			local targetTorso = targetChar:FindFirstChild("Torso") or targetHRP

			if selectedModeData.Type == "Stand" and targetHRP then
				forceCFrame(targetHRP.CFrame * CFrame.new(2.2, 0.4, 1.5))
			elseif selectedModeData.Type == "Orbit" and targetTorso then
				local offsetX = math.cos(orbitAngle) * selectedModeData.Radius
				local offsetZ = math.sin(orbitAngle) * selectedModeData.Radius
				forceCFrame(CFrame.new(targetTorso.Position + Vector3.new(offsetX, 0, offsetZ), targetTorso.Position))
			elseif selectedModeData.Type == "BangBang" and targetHRP then
				forceCFrame(targetHRP.CFrame * CFrame.new(0, 1.0, 2.2))
			end
		end
	end)
end

activateBtn.MouseButton1Click:Connect(function()
	if activeMode then
		stopExecution()
	else
		startExecution()
	end
end)

