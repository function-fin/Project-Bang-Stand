local function refreshPlayerList()
	for _, child in ipairs(playerScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local pBtn = Instance.new("TextButton")
			pBtn.Size = UDim2.new(1, -12, 0, 26)
			pBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
			pBtn.BorderSizePixel = 0
			-- Configuração para nomes longos não vazarem do botão
			pBtn.Text = " " .. player.DisplayName .. " (@" .. player.Name .. ")"
			pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			pBtn.TextSize = 10
			pBtn.Font = Enum.Font.Arcade
			pBtn.TextXAlignment = Enum.TextXAlignment.Left
			pBtn.TextTruncate = Enum.TextTruncate.AtEnd -- Adiciona reticências (...) se o nome for grande
			pBtn.ClipsDescendants = true
			pBtn.Parent = playerScroll

			local pStroke = Instance.new("UIStroke")
			pStroke.Color = Color3.fromRGB(60, 60, 60)
			pStroke.Thickness = 1
			pStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			pStroke.Parent = pBtn

			pBtn.MouseButton1Click:Connect(function()
				selectedTargetPlayer = player
				for _, child in ipairs(playerScroll:GetChildren()) do
					if child:IsA("TextButton") then
						child.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
						local stroke = child:FindFirstChildOfClass("UIStroke")
						if stroke then stroke.Color = Color3.fromRGB(60, 60, 60) end
					end
				end
				pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
				pStroke.Color = Color3.fromRGB(255, 255, 255)
			end)
		end
	end

	playerScroll.CanvasSize = UDim2.new(0, 0, 0, playerLayout.AbsoluteContentSize.Y + 10)
end

